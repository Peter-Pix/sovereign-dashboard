{
  "name": "sovereign-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/start.sh && vite --port 3205",
    "dev:frontend": "vite --port 3205",
    "server": "node server/index.cjs",
    "server:start": "bash scripts/start.sh",
    "server:stop": "bash scripts/stop.sh",
    "server:restart": "bash scripts/stop.sh && bash scripts/start.sh",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test": "node --test tests/unit.test.cjs",
    "test:unit": "node --test tests/unit.test.cjs",
    "test:integration": "node --test tests/integration.test.cjs",
    "test:all": "node --test tests/*.test.cjs",
    "test:e2e:slow": "playwright test --grep @slow"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
