# Šablona — zkopíruj do .env a doplň reálné hodnoty. NIKDY necommitovat .env.

# Auth token pro mutační endpointy. Vygeneruj: openssl rand -hex 32
SOVEREIGN_AUTH_TOKEN=

# Ollama LLM pro Paparazzi report
# CLOUD model (obsahuje ":cloud") se volá na https://ollama.com/api/chat
# a VYŽADUJE OLLAMA_API_KEY (Bearer token z https://ollama.com/settings/keys).
# LOKÁLNÍ model se volá na OLLAMA_URL (default localhost:11434).
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:cloud
# OLLAMA_URL=http://localhost:11434  # jen pro lokální modely

# ── Exekuce (paralelní pool) ──
# Max souběžných slotů. Default 3. Na 8GB mašině je pool chráněn memory
# guardem (EXEC_MEMORY_GUARD=1), který dynamicky omezí počet skutečně
# běžících agentů podle volné RAM — prevence OOM kill (Killed: 9).
EXEC_CONCURRENCY=3
# EXEC_MEMORY_GUARD=1   # 1 = guard aktivní (default), 0 = vypnutý (plný pool, risk OOM)
# EXEC_MIN_FREE_MB=1500 # min volná RAM (MB), pod kterou se nespouští další agent
# EXEC_AGENT_MEM_MB=250 # odhad paměti na 1 `openclaw agent` subproces
